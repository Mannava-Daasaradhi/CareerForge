# ─────────────────────────────────────────────
# CareerForge — Backend Environment Variables
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# ── AI Inference ──────────────────────────────
# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Google Gemini (free tier) — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# ── Database (optional — app runs in stateless mode without these) ──
# Supabase — https://supabase.com/dashboard/project/<project>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# ── GitHub API (optional but recommended) ─────
# Without this, the GitHub Auditor hits rate limits after ~60 unauthenticated requests/hour
# Create a classic token at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=ghp_...

# ── Code Sandbox ──────────────────────────────
# Uses public Piston API by default. Set this to self-host: https://github.com/engineer-man/piston
PISTON_API_URL=https://emkc.org/api/v2/piston
